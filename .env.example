# aq_server 用 .env の例
# このファイルを `.env` にコピーしてキーを記入してください（.env は git 管理外です）。
# 優先順位: コマンド引数 > 環境変数 > .env
#
#   cp .env.example .env
#   python3 aq_server.py --port 50082

# デフォルトエンジン: aquestalk10 (既定) または aquestalk1
# ※ 両エンジンは同居します。ここは旧クライアント互換表示の既定値で、
#    /synth の engine 指定（Chrome拡張の1/10切替）でいつでも切替できます。
AQ_ENGINE=aquestalk10

# AquesTalk1ライブラリのパスまたはディレクトリ（省略時は lib/ を自動探索）
# 例: AQ_AQUESTALK1_LIB=./lib
AQ_AQUESTALK1_LIB=

# AquesTalk10 開発キー（設定すると評価版制限〔ナ行・マ行→ヌ〕が解除されます）
AQ_DEV_KEY=
# AquesTalk10 使用キー（開発キーと併用）
AQ_USR_KEY=
# AqKanji2Koe 開発キー（漢字→音声記号列変換用）
AQ_KANJI_DEV_KEY=
# MeCab+NEologd辞書パス（漢字読み精度向上用・オプション）
# 例: AQ_MECAB_DIC=/usr/local/lib/mecab/dic/neologd
AQ_MECAB_DIC=
